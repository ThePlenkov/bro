#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Only format added/modified files, skip deleted files.
# Use NUL-delimited paths, pinned local binary, end-of-options marker.
# Re-stage ONLY files that don't have unstaged changes (preserve partial staging).
# Check for unstaged changes BEFORE formatting.
# Use GIT_LITERAL_PATHSPECS=1 and -- to prevent pathspec injection.
# Fail-open: hook errors never block commit.

# Get staged files (NUL-delimited) into temp file
tmpfile=$(mktemp)
git diff -z --name-only --cached --diff-filter=d | grep -z -E '\.(ts|tsx|js|json|md)$' > "$tmpfile" || true

# Exit early if no staged files
[ -s "$tmpfile" ] || { rm -f "$tmpfile"; exit 0; }

# Check which staged files have unstaged changes BEFORE formatting
unstaged_file=$(mktemp)
clean_file=$(mktemp)

tr '\0' '\n' < "$tmpfile" | while IFS= read -r file; do
  if git diff --name-only | grep -qxF "$file"; then
    echo "$file" >> "$unstaged_file"
  else
    echo "$file" >> "$clean_file"
  fi
done

# Format clean files (without unstaged changes)
if [ -s "$clean_file" ]; then
  tr '\n' '\0' < "$clean_file" | xargs -0 -r ./node_modules/.bin/biome format --write --
  # Re-stage the formatted clean files
  while IFS= read -r file; do
    GIT_LITERAL_PATHSPECS=1 git add -- "$file"
  done < "$clean_file"
fi

# Warn about skipped files
if [ -s "$unstaged_file" ]; then
  while IFS= read -r file; do
    echo "husky: skipped formatting $file (has unstaged changes)" >&2
  done < "$unstaged_file"
fi

rm -f "$tmpfile" "$unstaged_file" "$clean_file" || true