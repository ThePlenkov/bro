#!/usr/bin/env sh
# Source husky.sh best-effort; it may not exist in the repo (generated by husky install).
# Use . only if file exists, otherwise continue.
husky_sh="$(dirname -- "$0")/_/husky.sh"
[ -f "$husky_sh" ] && . "$husky_sh"


# Only format added/modified files, skip deleted files.
# Use NUL-delimited paths, pinned local binary, end-of-options marker.
# Re-stage ONLY files that don't have unstaged changes (preserve partial staging).
# Check for unstaged changes BEFORE formatting.
# Use GIT_LITERAL_PATHSPECS=1 and -- to prevent pathspec injection.
# A staged set with no Biome-processable files is successful; formatter errors
# must still block the commit.

# Keep this list in sync with the negated includes in biome.json. Biome exits
# nonzero when every path passed to one invocation is ignored, so remove those
# paths before invoking it instead of interpreting its diagnostic text.
is_biome_ignored() {
  case "$1" in
    */schemas/*|schemas/*|*/vendor/*|vendor/*)
      return 0
      ;;
    commands/bro.md|.opencode/commands/bro.md|site/content/docs/reference/*)
      return 0
      ;;
    specs/*|packages/brose/*|packages/brotocol/*)
      return 0
      ;;
    plugins/*/bro/bro.ts|plugins/*/bro/index.ts)
      return 0
      ;;
    packages/acp/model/src/content.ts|packages/acp/model/src/index.ts|\
    packages/acp/model/src/reducer.ts|packages/acp/model/src/sanitiser.ts|\
    packages/acp/model/src/types.ts)
      return 0
      ;;
  esac
  return 1
}

# Get staged files (NUL-delimited) into temp file
tmpfile=$(mktemp)
git diff -z --name-only --cached --diff-filter=d | grep -z -E '\.(ts|tsx|js|json|md)$' > "$tmpfile" || true

# Exit early if no staged files
[ -s "$tmpfile" ] || { rm -f "$tmpfile"; exit 0; }

# Check which staged files have unstaged changes BEFORE formatting
unstaged_file=$(mktemp)
clean_file=$(mktemp)
format_status=0

tr '\0' '\n' < "$tmpfile" | while IFS= read -r file; do
  is_biome_ignored "$file" && continue
  if git diff --name-only | grep -qxF "$file"; then
    echo "$file" >> "$unstaged_file"
  else
    echo "$file" >> "$clean_file"
  fi
done

# Format clean files (without unstaged changes)
if [ -s "$clean_file" ]; then
  tr '\n' '\0' < "$clean_file" | xargs -0 -r ./node_modules/.bin/biome format --write --no-errors-on-unmatched --
  format_status=$?
  # Re-stage the formatted clean files
  while IFS= read -r file; do
    GIT_LITERAL_PATHSPECS=1 git add -- "$file"
  done < "$clean_file"
fi

# Warn about skipped files
if [ -s "$unstaged_file" ]; then
  while IFS= read -r file; do
    echo "husky: skipped formatting $file (has unstaged changes)" >&2
  done < "$unstaged_file"
fi

rm -f "$tmpfile" "$unstaged_file" "$clean_file" || true
exit "$format_status"