{
  "act": {
    "ignoreChecks": [
      "kilo",
      "github-advanced-security"
    ],
    "docsPaths": [
      "*.md",
      "*.mdx",
      "*.rst",
      "docs/",
      "specs/",
      "site/content/"
    ]
  },
  "debt": {
    "sources": [
      "review-threads",
      "dependabot",
      "code-scanning",
      "secret-scanning",
      "stale-prs",
      "failed-ci"
    ]
  },
  "sdd": {
    "mode": "gate"
  },
  "agents": {
    "native": {
      "command": "devin -p --permission-mode dangerous --prompt-file {promptFile}"
    }
  },
  "fleet": {
    "maxConcurrent": 3
  },
  "judge": {
    "mode": "shadow",
    "provider": "orcarouter",
    "model": "typesafe/jev-1.13",
    "timeoutMs": 30000
  },
  "providers": {
    "kilo-cli": {
      "type": "acp",
      "command": "kilo acp",
      "model": "kilo/orcarouter/typesafe/jev-1.13"
    },
    "orcarouter": {
      "type": "api",
      "baseUrl": "https://api.orcarouter.ai",
      "apiKeyCommand": "secret-tool lookup service typesafe.ai",
      "models": {
        "typesafe/jev-1.13": "systemone",
        "typesafe/jev-latest": "systemone"
      }
    }
  }
}
