{
  "act": {
    "ignoreChecks": [
      "kilo",
      "github-advanced-security"
    ],
    "docsPaths": [
      "*.md",
      "*.mdx",
      "*.rst",
      "docs/",
      "specs/",
      "site/content/"
    ]
  },
  "debt": {
    "sources": [
      "review-threads",
      "dependabot",
      "code-scanning",
      "secret-scanning",
      "stale-prs",
      "failed-ci"
    ]
  },
  "sdd": {
    "mode": "gate"
  },
  "guard": {
    "defs": [
      {
        "name": "test-coverage-on-stop",
        "when": {
          "on": ["stop"],
          "state": {
            "diff": {
              "changed": ["src/**", "packages/*/src/**"],
              "without": ["**/*.test.*", "**/*.spec.*"]
            }
          }
        },
        "say": "src changed and no test file moved — is the new behavior covered?"
      },
      {
        "name": "spec-drift-nkn6",
        "when": {
          "on": ["stop"],
          "state": {
            "probes": [{ "name": "spec-drift", "args": { "spec": "specs/sessions/bro-nkn6.md" } }]
          }
        },
        "say": "specs/sessions/bro-nkn6.md is stale vs the code it scopes — refresh it"
      },
      {
        "name": "core-vendor-boundary",
        "when": {
          "on": ["stop"],
          "state": {
            "diff": { "changed": ["packages/core/src/**"] },
            "probes": [
              {
                "name": "core-vendor",
                "args": {
                  "path": "packages/core/src",
                  "terms": ["devin", "opencode", "gascity", "tmux", "claude", "codex", "gemini", "aider", "paseo", "cao"]
                }
              }
            ]
          }
        },
        "say": "vendor name in packages/core — REVIEW.md: core is vendor-neutral (major); move vendor knowledge to packages/cli/src/session-planes/ or a connector package"
      },
      {
        "name": "retro-on-stop",
        "when": { "on": ["stop"] },
        "say": "session ending — run the retro checklist (skills/retro): loose ends, hand-rolled mechanics → bd gap beads, call economy, `bro learn capture`, `bro debt collect`"
      }
    ]
  },
  "agents": {
    "native": {
      "command": "devin -p --permission-mode dangerous --prompt-file {promptFile}"
    },
    "devin": {
      "maxSessions": 6
    }
  },
  "fleet": {
    "maxConcurrent": 3
  },
  "judge": {
    "mode": "shadow",
    "provider": "orcarouter",
    "model": "typesafe/jev-1.13",
    "timeoutMs": 30000
  },
  "providers": {
    "kilo-cli": {
      "type": "acp",
      "command": "kilo acp",
      "model": "kilo/orcarouter/typesafe/jev-1.13"
    },
    "orcarouter": {
      "type": "api",
      "baseUrl": "https://api.orcarouter.ai",
      "apiKeyCommand": "secret-tool lookup service typesafe.ai",
      "models": {
        "typesafe/jev-1.13": "systemone",
        "typesafe/jev-latest": "systemone"
      }
    },
    "opencode-free": {
      "type": "cli",
      "command": "opencode run --model {model} --auto -f {promptFile} 'Follow the attached instructions.'",
      "model": "opencode/space-bunny-free"
    }
  }
}
