{
  "act": {
    "ignoreChecks": [
      "kilo",
      "github-advanced-security"
    ],
    "docsPaths": [
      "*.md",
      "*.mdx",
      "*.rst",
      "docs/",
      "specs/",
      "site/content/"
    ]
  },
  "debt": {
    "sources": [
      "review-threads",
      "dependabot",
      "code-scanning",
      "secret-scanning",
      "stale-prs",
      "failed-ci"
    ]
  },
  "sdd": {
    "mode": "gate"
  },
  "fleet": {
    "maxConcurrent": 3
  },
  "judge": {
    "mode": "shadow",
    "provider": "kilo-cli",
    "timeoutMs": 300000
  },
  "providers": {
    "kilo-cli": {
      "type": "acp",
      "command": "kilo acp",
      "model": "kilo/orcarouter/typesafe/jev-1.13"
    }
  }
}
