{
  "description": "bro plugin hooks. Codex sets PLUGIN_ROOT; hooks/run.sh resolves the bro binary.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" session-start || true",
            "timeout": 20,
            "statusMessage": "bro session context"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" pre-compact || true",
            "timeout": 20,
            "statusMessage": "bro pre-compact"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" post-compaction || true",
            "timeout": 20,
            "statusMessage": "bro post-compact"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" prompt-submit || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" post-tool || true",
            "timeout": 10,
            "statusMessage": "bro post-tool"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" permission || true",
            "timeout": 10,
            "statusMessage": "bro permission"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/run.sh\" stop || true",
            "timeout": 25,
            "statusMessage": "bro stop gate"
          }
        ]
      }
    ]
  }
}
