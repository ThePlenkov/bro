{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"${DEVIN_PLUGIN_ROOT}/hooks/run.sh\" session-start || true",
          "timeout": 20
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"${DEVIN_PLUGIN_ROOT}/hooks/run.sh\" post-compaction || true",
          "timeout": 20
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"${DEVIN_PLUGIN_ROOT}/hooks/run.sh\" prompt-submit || true",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "if _f=$(mktemp 2>/dev/null) && [ -n \"$_f\" ]; then if cat > \"$_f\"; then (\"${DEVIN_PLUGIN_ROOT}/hooks/run.sh\" post-tool < \"$_f\"; rm -f \"$_f\") </dev/null >/dev/null 2>&1 & else rm -f \"$_f\"; fi; else \"${DEVIN_PLUGIN_ROOT}/hooks/run.sh\" post-tool >/dev/null 2>&1 || true; fi; exit 0",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"${DEVIN_PLUGIN_ROOT}/hooks/run.sh\" stop || true",
          "timeout": 25
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "\"${DEVIN_PLUGIN_ROOT}/hooks/run.sh\" permission || true",
          "timeout": 10
        }
      ]
    }
  ]
}
