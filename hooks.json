{
  "SessionStart": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PLUGIN_ROOT/hooks/run.sh\" session-start",
          "timeout": 20
        }
      ]
    }
  ],
  "PostCompaction": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PLUGIN_ROOT/hooks/run.sh\" post-compaction",
          "timeout": 20
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PLUGIN_ROOT/hooks/run.sh\" prompt-submit",
          "timeout": 15
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PLUGIN_ROOT/hooks/run.sh\" post-tool",
          "timeout": 10
        }
      ]
    }
  ],
  "Stop": [
    {
      "matcher": "",
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PLUGIN_ROOT/hooks/run.sh\" stop",
          "timeout": 25
        }
      ]
    }
  ],
  "PermissionRequest": [
    {
      "matcher": "^exec$",
      "hooks": [
        {
          "type": "command",
          "command": "\"$DEVIN_PLUGIN_ROOT/hooks/run.sh\" permission",
          "timeout": 10
        }
      ]
    }
  ]
}
