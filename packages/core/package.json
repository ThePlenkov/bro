{
  "name": "@broject/core",
  "version": "0.3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "smol-toml": "^1.9.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/bro.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "Shared primitives for bro packages — gh/git/bd wrappers, config, plugin surface, task store",
  "keywords": [
    "beads",
    "github-cli",
    "plugin",
    "agent",
    "bro"
  ],
  "homepage": "https://broject.dev/docs",
  "bro": {
    "kind": "core",
    "status": "beta"
  },
  "nx": {
    "targets": {
      "test": {
        "inputs": [
          "default",
          "{workspaceRoot}/skills/**/*"
        ]
      }
    }
  }
}
