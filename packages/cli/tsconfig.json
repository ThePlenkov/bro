{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // DOM stays in the set because the default lib for the target
    // includes it, and dropping it would retype every DOM global the
    // tests touch.
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
  },
  "include": ["src/**/*.ts", "tsdown.config.ts"]
}
