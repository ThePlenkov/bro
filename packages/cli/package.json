{
  "name": "@theplenkov/bro",
  "version": "0.2.0",
  "description": "bro — agent's sidekick CLI: review-debt pipeline, PR triage, fix loops",
  "type": "module",
  "bin": {
    "bro": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
    "prepack": "node -e \"const{copyFileSync}=require('node:fs');for(const f of['README.md','LICENSE'])copyFileSync('../../'+f,f)\"",
    "postpack": "node -e \"const{rmSync}=require('node:fs');for(const f of['README.md','LICENSE'])rmSync(f,{force:true})\""
  },
  "dependencies": {
    "smol-toml": "1.7.1"
  },
  "devDependencies": {
    "@bro/act": "*",
    "@bro/core": "*",
    "@bro/debt": "*",
    "@bro/drill": "*",
    "@bro/retro": "*",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/bro.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ThePlenkov/bro#readme",
  "bugs": {
    "url": "https://github.com/ThePlenkov/bro/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
