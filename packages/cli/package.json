{
  "name": "@broject/bro",
  "version": "0.2.5",
  "description": "bro \u2014 agent's sidekick CLI: the rig that owns the PR-to-merge loop \u2014 fleet, convoy, review gates, mesh, debt sweep",
  "keywords": [
    "agent-rig",
    "orchestration",
    "fleet",
    "convoy",
    "mesh",
    "pr-review",
    "merge-gate",
    "review-debt",
    "beads",
    "agent-workflow"
  ],
  "type": "module",
  "bin": {
    "bro": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./server": {
      "types": "./dist/opencode.d.ts",
      "default": "./dist/opencode.js"
    },
    "./tui": {
      "types": "./dist/opencode-tui.d.ts",
      "default": "./dist/opencode-tui.js"
    },
    "./kilo": {
      "types": "./dist/kilo.d.ts",
      "default": "./dist/kilo.js"
    },
    "./pi": {
      "types": "./dist/pi.d.ts",
      "default": "./dist/pi.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "tsx --test src/*.test.ts src/**/*.test.ts",
    "prepack": "node ../../scripts/pack-cli.ts pre",
    "postpack": "node ../../scripts/pack-cli.ts post",
    "typecheck": "tsc --noEmit"
  },
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "default",
          "{workspaceRoot}/skills/**/*",
          "{workspaceRoot}/formulas/**/*",
          "{workspaceRoot}/packages/*/dist/**/*"
        ]
      }
    }
  },
  "dependencies": {
    "@broject/bro-pack": "^0.2.0",
    "@broject/devin": "^0.2.5",
    "@broject/mcp": "^0.2.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "smol-toml": "^1.9.0",
    "sverka": "^0.2.10"
  },
  "devDependencies": {
    "@kilocode/plugin": "^7.8.3",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/bro.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/ThePlenkov/bro#readme",
  "bugs": {
    "url": "https://github.com/ThePlenkov/bro/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
