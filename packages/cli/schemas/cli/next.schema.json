{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broject.dev/schemas/cli/next.schema.json",
  "title": "bro next --json (flow next)",
  "type": "object",
  "additionalProperties": false,
  "required": ["state", "beads", "queue", "filtered", "foreign", "gates", "epics", "moleculeSteps"],
  "properties": {
    "state": {
      "type": "string",
      "enum": ["task", "gated", "idle"]
    },
    "bead": {
      "$ref": "#/$defs/ReadyBead"
    },
    "beads": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ReadyBead"
      }
    },
    "queue": { "type": "integer" },
    "filtered": { "type": "integer" },
    "foreign": { "type": "integer" },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "epics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" }
        }
      }
    },
    "moleculeSteps": { "type": "integer" }
  },
  "$defs": {
    "ReadyBead": {
      "type": "object",
      "additionalProperties": true,
      "required": ["id", "title", "status", "priority", "issue_type", "created_at"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "number" },
        "issue_type": { "type": "string" },
        "created_at": { "type": "string" },
        "parent": { "type": "string" },
        "labels": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
