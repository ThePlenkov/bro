{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broject.dev/schemas/cli/debt-next.schema.json",
  "title": "bro debt next --json",
  "description": "One DebtRecord — mirrors DebtRecord in packages/debt/src/types.ts. Closed-world: a field rename/removal must fail this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "thread_id",
    "thread_url",
    "status",
    "priority",
    "needs",
    "source_pr",
    "source_pr_url",
    "source_pr_title",
    "merged_at",
    "merged_sha",
    "path",
    "line",
    "author",
    "body",
    "body_preview",
    "fingerprint",
    "area",
    "harvested_at",
    "harvest_run_id",
    "times_seen",
    "fix_pr",
    "fixed_at",
    "notes"
  ],
  "properties": {
    "thread_id": { "type": "string" },
    "thread_url": { "type": "string" },
    "status": { "enum": ["open", "claimed", "done", "wontfix", "duplicate"] },
    "priority": { "enum": ["blocking", "human", "nit", "scan", "noise"] },
    "needs": { "enum": ["code_change", "reply_only", "skip"] },
    "source_pr": { "type": "integer" },
    "source_pr_url": { "type": "string" },
    "source_pr_title": { "type": "string" },
    "merged_at": { "type": "string" },
    "merged_sha": { "type": "string" },
    "path": { "type": "string" },
    "line": { "type": ["integer", "null"] },
    "author": { "type": "string" },
    "body": { "type": "string" },
    "body_preview": { "type": "string" },
    "fingerprint": { "type": "string" },
    "area": { "type": "string" },
    "harvested_at": { "type": "string" },
    "harvest_run_id": { "type": "string" },
    "times_seen": { "type": "integer" },
    "fix_pr": { "type": ["integer", "null"] },
    "fixed_at": { "type": ["string", "null"] },
    "notes": { "type": ["string", "null"] },
    "source": {
      "type": "string",
      "description": "Collector feed the row came from — absent on review-thread rows (back-compat)."
    }
  }
}
