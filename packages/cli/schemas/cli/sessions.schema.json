{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broject.dev/schemas/cli/sessions.schema.json",
  "title": "bro sessions --json",
  "type": "object",
  "additionalProperties": true,
  "required": ["sessions", "warnings"],
  "properties": {
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["host", "sid", "state", "mode", "lastSeen"],
        "properties": {
          "host": { "type": "string" },
          "sid": { "type": "string" },
          "project": { "type": ["string", "null"] },
          "cwd": { "type": ["string", "null"] },
          "branch": { "type": ["string", "null"] },
          "mode": { "type": "string" },
          "state": {
            "type": "string",
            "description": "derived display state — live|idle|ended|interrupted"
          },
          "pid": { "type": ["number", "null"] },
          "pidStart": { "type": ["string", "null"] },
          "started": { "type": ["number", "null"], "description": "epoch ms" },
          "lastSeen": { "type": "number", "description": "epoch ms" },
          "spawnedBy": { "type": ["string", "null"] },
          "bead": { "type": ["string", "null"] }
        }
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
