{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broject.dev/schemas/cli/claim.schema.json",
  "title": "bro claim --json",
  "description": "One of three verb documents — claim → {ok,resource,session,conflict}; release → {released,session}; list → {claims,warnings}. Mirrors ClaimRow/SessionKey in packages/core/src/claims.ts.",
  "anyOf": [
    { "$ref": "#/$defs/ClaimVerdict" },
    { "$ref": "#/$defs/ReleaseVerdict" },
    { "$ref": "#/$defs/ClaimList" }
  ],
  "$defs": {
    "SessionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "sid"],
      "properties": {
        "host": { "type": "string" },
        "sid": { "type": "string" }
      }
    },
    "ClaimRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "host",
        "sid",
        "project",
        "exclusive",
        "leaseUntil",
        "claimedAt"
      ],
      "properties": {
        "resource": { "type": "string", "description": "The claimed URI — worktree:|branch:|task:|pr:|path:|role:" },
        "host": { "type": "string" },
        "sid": { "type": "string" },
        "project": { "type": ["string", "null"] },
        "exclusive": { "type": "boolean" },
        "leaseUntil": { "type": ["number", "null"], "description": "Epoch ms; null = no expiry." },
        "claimedAt": { "type": "number", "description": "Epoch ms." },
        "pid": { "type": ["integer", "null"] },
        "pidStart": { "type": ["string", "null"] },
        "ttlMs": { "type": ["number", "null"] },
        "detail": { "type": ["string", "null"] }
      }
    },
    "ClaimVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "resource", "session", "conflict"],
      "properties": {
        "ok": { "type": "boolean" },
        "resource": { "type": "string" },
        "session": { "$ref": "#/$defs/SessionKey" },
        "conflict": {
          "type": ["object", "null"],
          "description": "The standing claim that blocked this one, when ok is false — null when the claim landed.",
          "anyOf": [{ "$ref": "#/$defs/ClaimRow" }, { "type": "null" }]
        }
      }
    },
    "ReleaseVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["released", "session"],
      "properties": {
        "released": { "type": "string", "description": "The released resource URI." },
        "session": { "$ref": "#/$defs/SessionKey" }
      }
    },
    "ClaimList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claims", "warnings"],
      "properties": {
        "claims": { "type": "array", "items": { "$ref": "#/$defs/ClaimRow" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
