{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broject.dev/schemas/cli/fleet-hosts.schema.json",
  "title": "bro fleet hosts --json",
  "description": "{hosts, projects, generatedAt, warnings} — mirrors FleetHostsPayload/FleetHostRow/FleetProjectRow in packages/cli/src/commands/fleet-hosts.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hosts", "projects", "generatedAt", "warnings"],
  "properties": {
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "host",
          "pluginRoots",
          "firstSeen",
          "lastSeen",
          "status",
          "sessions",
          "liveSessions",
          "events",
          "timeouts",
          "errors"
        ],
        "properties": {
          "host": { "type": "string" },
          "adapter": { "type": "string", "description": "adapterVersion of the most recently seen install row." },
          "pluginRoots": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Distinct plugin roots bro is wired through for this host."
          },
          "firstSeen": { "type": "number", "description": "epoch ms" },
          "lastSeen": { "type": "number", "description": "epoch ms — max across installs, sessions and stats days" },
          "status": { "type": "string", "enum": ["firing", "quiet", "silent"] },
          "sessions": { "type": "number" },
          "liveSessions": { "type": "number" },
          "events": { "type": "number", "description": "Summed hook events over retained daily stats." },
          "p95": { "type": "number", "description": "worst daily p95 ms" },
          "timeouts": { "type": "number" },
          "errors": { "type": "number" },
          "lastErrorDay": { "type": "string", "description": "UTC YYYY-MM-DD" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["project", "label", "sessions", "liveSessions", "hosts"],
        "properties": {
          "project": {
            "type": ["string", "null"],
            "description": "Ledger project id; null when the session carried none."
          },
          "label": {
            "type": "string",
            "description": "basename of the group's most recently seen cwd (— when none)."
          },
          "sessions": { "type": "number" },
          "liveSessions": { "type": "number" },
          "hosts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "generatedAt": { "type": "number", "description": "epoch ms" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
