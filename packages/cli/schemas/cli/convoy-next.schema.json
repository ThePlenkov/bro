{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://broject.dev/schemas/cli/convoy-next.schema.json",
  "title": "bro convoy next",
  "description": "ConvoyNext — the always-JSON emit of `bro convoy next` (packages/cli/src/commands/convoy.ts: JSON.stringify(withInputs(nextStep(mol), mol)); ConvoyNext in packages/convoy/src/types.ts). There is no --json flag: the emit is the contract. `step` rides only on step|gate states; `inputs` rides only when the selected step has closed direct dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mol", "state", "ready", "gates", "inProgress", "blocked", "stuck"],
  "properties": {
    "mol": { "type": "string" },
    "state": { "enum": ["step", "gate", "blocked", "complete"] },
    "ready": {
      "type": "array",
      "items": { "$ref": "#/$defs/convoyStep" }
    },
    "step": { "$ref": "#/$defs/convoyStep" },
    "gates": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inProgress": {
      "type": "array",
      "items": { "type": "string" }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "reason"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "blocked": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stuck": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "$defs": {
    "convoyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "type", "kind", "state", "blockedBy"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "type": {
          "type": "string",
          "description": "declared issue_type — agent|human|task (flattened legacy types land here)"
        },
        "kind": { "enum": ["agent", "human"] },
        "state": { "enum": ["done", "ready", "blocked", "in_progress"] },
        "blockedBy": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
