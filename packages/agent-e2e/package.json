{
  "name": "@broject/agent-e2e",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "tsx --test src/**/*.e2e.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.48.0",
    "@broject/bro": "^0.3.0"
  },
  "nx": {
    "targets": {
      "test:e2e": {
        "dependsOn": [
          "^build",
          "build",
          {
            "target": "test:e2e",
            "projects": "@broject/bro"
          }
        ]
      }
    }
  }
}
