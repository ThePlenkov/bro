{
  "name": "@broject/pi",
  "version": "0.3.0",
  "type": "module",
  "dependencies": {
    "@broject/adapter-core": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./dist/pi.d.ts",
      "default": "./dist/pi.js"
    }
  },
  "scripts": {
    "test": "tsx --test src/**/*.test.ts",
