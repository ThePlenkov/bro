{
  "name": "@broject/opencode",
  "version": "0.3.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/opencode.d.ts",
      "default": "./dist/opencode.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "default": "./dist/tui.js"
    },
    "./rpc": {
      "types": "./dist/rpc.d.ts",
      "default": "./dist/rpc.js"
    }
  },
  "scripts": {
    "test": "tsx --test src/**/*.test.ts src/**/*.test.tsx",
    "typecheck": "tsc --noEmit",
    "build": "tsdown"
  },
  "devDependencies": {
    "@opencode/plugin": "^2.1.4",
    "@opentui/core": "^0.7.0",
    "@opentui/solid": "^0.7.0",
    "solid-js": "^1.9.12"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.8",
    "@opentui/solid": ">=0.6.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThePlenkov/bro.git",
    "directory": "packages/agent-plugins/opencode"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "bro's OpenCode plugin — server + TUI + RPC parts"
}
