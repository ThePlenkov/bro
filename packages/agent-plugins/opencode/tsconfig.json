{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    // tui.tsx — Solid/OpenTUI JSX; the opencode host resolves the
    // runtime, devDeps only type it
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["src"]
}
