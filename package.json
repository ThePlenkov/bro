{
  "name": "bro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/gen-plugins.ts && nx run-many -t build --exclude=skills-*,plugins-*-skills-*",
    "check:docs": "node scripts/check-docs.ts",
    "check:command-docs": "node scripts/gen-command-docs.ts --check",
    "gen:command-docs": "node scripts/gen-command-docs.ts",
    "check:contract": "node scripts/check-contract.ts",
    "gen:contract": "node scripts/check-contract.ts --write",
    "check:embedded": "node scripts/check-embedded.ts",
    "check:codescene": "node scripts/codescene-check.ts",
    "gen:plugins": "node scripts/gen-plugins.ts",
    "check:plugins": "node scripts/gen-plugins.ts --check",
    "test": "nx run-many -t test --exclude=skills-*,plugins-*-skills-*",
    "lint": "biome lint",
    "affected": "nx affected -t build test lint --exclude=skills-*,plugins-*-skills-*",
    "typecheck": "nx run-many -t typecheck --exclude=skills-*,plugins-*-skills-*",
    "prepare": "husky",
    "format": "biome format --write",
    "format:check": "biome format"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@nx-devkit/prepare-for-release": "^0.1.14",
    "@nx-devkit/skill": "^0.1.9",
    "@nx-devkit/skillspector": "^0.1.9",
    "@nx-devkit/tsdown": "^0.1.7",
    "@nx/js": "^23.2.1",
    "@types/node": "^22.0.0",
    "husky": "^9.1.7",
    "nx": "^23.1.0",
    "rolldown": "1.0.0-beta.45",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "overrides": {
    "smol-toml": "^1.9.0",
    "axios": "^1.20.0",
    "brace-expansion": "^5.0.12",
    "katex": "^0.19.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "follow-redirects": "1.16.1",
    "undici": "8.12.3",
    "body-parser": "2.4.0"
  },
  "allowScripts": {
    "nx@23.2.1": true,
    "esbuild@0.28.2": true
  }
}
