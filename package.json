{
  "name": "bro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/gen-embedded.mjs && nx run-many -t build --exclude=skills-*",
    "check:embedded": "node scripts/gen-embedded.mjs --check",
    "test": "nx run-many -t test --exclude=skills-*",
    "lint": "nx run-many -t lint",
    "affected": "nx affected -t build test lint --exclude=skills-*",
    "build:nx-plugins": "tsx scripts/build-nx-plugins.ts",
    "patch:nx": "tsx scripts/patch-nx-submodule.ts"
  },
  "devDependencies": {
    "@nx-devkit/skill": "file:./vendor/nx.ts/packages/skill",
    "@nx-devkit/skillspector": "file:./vendor/nx.ts/packages/skillspector",
    "@nx-devkit/tsdown": "file:./vendor/nx.ts/packages/tsdown",
    "@types/node": "^22.0.0",
    "nx": "^23.1.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "smol-toml": "1.7.1"
  }
}
