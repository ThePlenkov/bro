{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "cache": false
    },
    "test": {
      "dependsOn": [
        "^build",
        "build"
      ]
    }
  },
  "release": {
    "projects": [
      "@broject/*",
      "!@broject/site"
    ],
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false
      }
    },
    "version": {
      "conventionalCommits": true
    },
    "releaseTag": {
      "pattern": "v{version}"
    }
  },
  "plugins": [
    {
      "plugin": "@nx-devkit/tsdown",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/skill",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/skillspector",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/prepare-for-release",
      "options": {}
    }
  ],
  "nxCloudId": "6ac40919e891443e6ed11ebf"
}