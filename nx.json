{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": true,
      "inputs": [
        "default",
        "envGates",
        "{workspaceRoot}/plugin.json",
        "{workspaceRoot}/skills/**/*",
        "{workspaceRoot}/.claude-plugin/**/*",
        "{workspaceRoot}/.codex-plugin/**/*"
      ]
    }
  },
  "namedInputs": {
    "envGates": [
      { "env": "BRO_MESH_E2E_REPO" },
      { "env": "BRO_MESH_WL_E2E" },
      { "env": "CODACY_API_TOKEN" },
      { "env": "CODACY_PROJECT_TOKEN" },
      { "env": "CODESCENE_TOKEN" },
      { "env": "SONAR_TOKEN" }
    ]
  },
  "release": {
    "projects": ["@broject/*", "!@broject/site"],
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false
      }
    },
    "version": {
      "conventionalCommits": true
    },
    "releaseTag": {
      "pattern": "v{version}"
    }
  },
  "plugins": [
    {
      "plugin": "@nx-devkit/tsdown",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/skill",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/skillspector",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/prepare-for-release",
      "options": {}
    }
  ],
  "nxCloudId": "6ac40919e891443e6ed11ebf"
}
