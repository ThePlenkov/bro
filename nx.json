{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["^build"]
    }
  },
  "release": {
    "projects": ["@theplenkov/bro"],
    "version": {
      "conventionalCommits": true
    },
    "releaseTag": {
      "pattern": "v{version}"
    }
  },
  "plugins": [
    {
      "plugin": "@nx-devkit/tsdown",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/skill",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/skillspector",
      "options": {}
    }
  ]
}
