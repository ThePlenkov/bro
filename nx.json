{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "targetDefaults": {
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": [
        "default",
        {
          "externalDependencies": ["typescript"]
        }
      ]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "cache": true
    },
    "test:e2e": {
      "dependsOn": ["^build", "build"],
      "cache": true,
      "inputs": ["default", "envGates"]
    }
  },
  "namedInputs": {
    "pluginSurface": [
      "{workspaceRoot}/plugin.json",
      "{workspaceRoot}/plugins/**/*",
      "{workspaceRoot}/packages/agent-plugins/**/*",
      "{workspaceRoot}/.claude-plugin/**/*",
      "{workspaceRoot}/.codex-plugin/**/*",
      "{workspaceRoot}/.agents/**/*",
      "{workspaceRoot}/skills/**/*",
      "{workspaceRoot}/formulas/**/*",
      "{workspaceRoot}/hooks/**/*",
      "{workspaceRoot}/hooks.json",
      "{workspaceRoot}/dogfood/**/*"
    ],
    "envGates": [
      {
        "env": "BRO_MESH_E2E_REPO"
      },
      {
        "env": "BRO_MESH_WL_E2E"
      },
      {
        "env": "CODACY_API_TOKEN"
      },
      {
        "env": "CODACY_PROJECT_TOKEN"
      },
      {
        "env": "CODESCENE_TOKEN"
      },
      {
        "env": "SONAR_TOKEN"
      }
    ]
  },
  "release": {
    "projects": ["@broject/*", "!@broject/site"],
    "changelog": {
      "workspaceChangelog": {
        "createRelease": false
      }
    },
    "version": {
      "conventionalCommits": true,
      "preserveMatchingDependencyRanges": false
    },
    "releaseTag": {
      "pattern": "v{version}"
    }
  },
  "plugins": [
    {
      "plugin": "@nx-devkit/tsdown",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/skill",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/skillspector",
      "options": {}
    },
    {
      "plugin": "@nx-devkit/prepare-for-release",
      "options": {}
    }
  ],
  "nxCloudId": "6ac40919e891443e6ed11ebf",
  "affected": {
    "legacy": true
  }
}
