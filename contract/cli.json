    "debt": {
      "name": "debt",
      "group": "review",
      "summary": "Review-debt pipeline: collect|status|prs|list|mark|sync|set",
      "spellings": [
        "debt",
        "review debt"
      ],
      "aliases": [],
      "hidden": false,
      "skill": "debt",
      "configKey": "debt",
      "plan": true,
      "planVersion": 1,
      "contract": {
        "subs": {
          "status": {
            "exits": {
              "0": "ledger summary printed",
              "1": "usage (debt usage exits 1 today)"
            }
          },
          "next": {
            "flags": {
              "--json": "the finding row as JSON",
              "--claim": "mark the finding claimed atomically (CAS)",
              "--area <a>": "only findings in this area",
              "--author <u>": "only findings from this thread author"
            },
            "exits": {
              "0": "top open finding emitted",
              "1": "no open findings, or the claim CAS lost",
              "2": "usage"
            }
          }
        }
      },
      "external": false
    },
    "act": {
      "name": "act",
      "group": "review",
      "summary": "Open-PR loop: status|threads|resolve|reply|merge",
      "spellings": [
        "act",
        "review act"
      ],
      "aliases": [],
      "hidden": false,
      "skill": "act",
      "configKey": "act",
      "plan": true,
      "planVersion": 1,
      "contract": {
        "subs": {
          "status": {
            "flags": {
              "--json": "PR state + exit gate as one JSON document",
              "--pr <n>": "the PR to inspect — default: the current branch"
            },
            "exits": {
              "0": "exit gate green",
              "1": "gate blocked — threads/failures remain (usage errors also exit 1 today)",
              "2": "no open PR for the current branch"
            }
          }
        }
      },
      "external": false
    },
